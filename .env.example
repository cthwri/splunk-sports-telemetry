# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Splunk admin password (used by docker-compose on first start)
SPLUNK_PASSWORD=change-me

# HTTP Event Collector
SPLUNK_HEC_URL=https://localhost:8088
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000
SPLUNK_HEC_INDEX=wnba
